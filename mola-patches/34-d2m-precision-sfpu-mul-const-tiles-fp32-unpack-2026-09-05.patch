diff --git a/test/ttmlir/Dialect/D2M/Transforms/insert_dst_register_access_bf16_mul_sfpu.mlir b/test/ttmlir/Dialect/D2M/Transforms/insert_dst_register_access_bf16_mul_sfpu.mlir
