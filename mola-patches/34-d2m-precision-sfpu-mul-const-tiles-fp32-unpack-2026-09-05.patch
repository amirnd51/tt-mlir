+// CHECK: %[[IN1_DST:.*]] = affine.load %[[DST]][{{.*}} + 1]
+// CHECK: %[[MUL:.*]] = "d2m.tile_mul"(%[[IN0_DST]], %[[IN1_DST]])
+// CHECK: affine.store %[[MUL]], %[[DST]][{{.*}}]
